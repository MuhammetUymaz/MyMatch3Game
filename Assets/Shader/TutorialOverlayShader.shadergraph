    "m_ObjectId": "6b2768a27fef41dbb9614e8850ba07ea",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ColorArranger (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -823.0,
            "y": 146.50003051757813,
